# Wind Data Agent runtime wiring (MCP endpoint)
# This URL targets the deployed Wind Data Agent artifact in Fabric.
VITE_DATA_AGENT_URL=https://api.fabric.microsoft.com/v1/mcp/workspaces/c4e0ab47-88d2-452d-ac98-ad101b574cf3/dataagents/d3d068a2-f135-413c-9ed2-bdb921ad5a97/agent

# Data Agent MCP endpoints require bearer auth.
VITE_DATA_AGENT_AUTH_SCHEME=bearer

# Force MCP transport for the published Data Agent endpoint.
VITE_DATA_AGENT_MODE=mcp

# Set a valid Fabric bearer token for runtime calls.
# Example (PowerShell):
#   (Get-AzAccessToken -ResourceUrl "https://api.fabric.microsoft.com").Token
# VITE_DATA_AGENT_KEY=<paste-access-token>
