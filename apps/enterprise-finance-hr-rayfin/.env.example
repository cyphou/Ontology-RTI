# Fabric semantic model connection alias generated by fabric-app-data. Leave unset for synthetic data.
VITE_LIVE_TELEMETRY_MODEL=enterpriseFinanceHrModel

# Optional Data Agent gateway. It must authenticate users server-side or through the Fabric host.
# Never put a bearer token or client secret in a VITE_ variable: browser environment variables are public.
VITE_DATA_AGENT_URL=https://your-approved-agent-gateway.example.com/ask
VITE_DATA_AGENT_MODE=legacy
VITE_DATA_AGENT_MCP_TOOL=ask_data_agent