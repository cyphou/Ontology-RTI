# Copy to .env and fill in. .env and .env.local are gitignored: never commit real values.
# Vite merges .env + .env.local; `rayfin env` regenerates .env.local, so put durable values here.

# --- Live telemetry: deployed SolarFarm semantic model (Direct Lake) ---
# Name or dataset id of the deployed semantic model. Leave unset to run on synthetic data.
VITE_LIVE_TELEMETRY_MODEL=solarFarmModel

# --- GenAI: Fabric Data Agent (powers Scenario Lab "GenAI analysis" + "Ask Fabric IQ") ---
# When set, GenAI answers route here and fall back to the offline engine on error.
VITE_DATA_AGENT_URL=https://your-approved-agent-gateway.example.com/ask

# Transport negotiation: auto | mcp | legacy   (default: auto)
VITE_DATA_AGENT_MODE=auto

# Auth scheme: bearer | api-key | none         (default: bearer)
VITE_DATA_AGENT_AUTH_SCHEME=bearer

# Never put a bearer token or client secret in a VITE_ variable: browser environment
# variables are embedded in the bundle and are therefore public. Authenticate users
# server-side or through the Fabric host instead.
# VITE_DATA_AGENT_KEY=

# --- Generated, do not add here ---
# `rayfin env` writes VITE_RAYFIN_* and VITE_FABRIC_* into .env.local from rayfin/.env.
# Both files are gitignored because they carry workspace, capacity and tenant identifiers.
