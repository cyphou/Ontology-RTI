# Persistent local env for the refinery Rayfin app.
# `rayfin env` only regenerates .env.local (Fabric host IDs), so values placed here
# survive rebuilds. Vite merges .env + .env.local. Uncomment and fill to go live.
# NOTE: keep real tokens OUT of source control (treat VITE_DATA_AGENT_KEY as a secret).

# --- GenAI: Fabric Data Agent (powers Scenario Lab "GenAI analysis" + "Ask Fabric IQ") ---
# Published Data Agent / AI Skill invocation endpoint. When set, GenAI answers route
# here (badge turns to "Fabric Data Agent (live)") and fall back to the offline engine on error.
# VITE_DATA_AGENT_URL=

# Bearer token for the endpoint (Fabric AAD token). Secret — do not commit.
# VITE_DATA_AGENT_KEY=

# Transport negotiation: auto | mcp | legacy   (default: auto)
# VITE_DATA_AGENT_MODE=auto

# Auth scheme: bearer | api-key | none          (default: bearer)
# VITE_DATA_AGENT_AUTH_SCHEME=bearer

# --- Live telemetry: deployed OilGasRefinery semantic model (Direct Lake) ---
# Name or dataset id of the deployed semantic model; lights up real refinery readings
# in place of the synthetic generator.
# VITE_LIVE_TELEMETRY_MODEL=OilGasRefineryModel
