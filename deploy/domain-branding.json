{
  "$comment": "Single source of brand truth per ontology domain. The report theme, the generated logo lockup and the mockup all read this file, so a domain cannot drift between them. Palettes are derived from each domain's own icon in assets/icons, which keeps the report visually tied to the domain it describes.",
  "version": "1.0",
  "defaults": {
    "foreground": "#1B1F23",
    "mutedText": "#5C6B7A",
    "border": "#E3E8EF",
    "visualBackground": "#FFFFFF",
    "pageBackground": "#F5F7FA",
    "outspace": "#E9EDF2",
    "good": "#0F766E",
    "neutral": "#B45309",
    "bad": "#B91C1C",
    "$comment": "good/neutral/bad are semantic: they carry meaning, so they are never reused as ordinary series colours.",
    "measureColors": {
      "$comment": "Role-based colour binding. A measure whose name matches a pattern keeps the same colour on every page, which is the 'be consistent with the colours you use' rule from Microsoft guidance.",
      "actual": {
        "match": "actual|spend|cost|output|production",
        "color": "$accent"
      },
      "plan": {
        "match": "budget|plan|target|goal|capacity",
        "color": "$muted"
      },
      "forecast": {
        "match": "forecast|predicted|projection",
        "color": "$secondary"
      },
      "variance": {
        "match": "variance|delta|gap",
        "color": "$semantic"
      }
    }
  },
  "domains": {
