table dimproject
	column ProjectId
		dataType: string
		sourceColumn: ProjectId
	column ProjectName
		dataType: string
		sourceColumn: ProjectName
	column CostCenterId
		dataType: string
		sourceColumn: CostCenterId
	column ProjectStatus
