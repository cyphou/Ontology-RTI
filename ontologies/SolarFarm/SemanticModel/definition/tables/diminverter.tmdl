table diminverter
	lineageTag: 70000013-0001-0001-0001-000000000001

	measure 'Inverter Count' = COUNTROWS(diminverter)
		displayFolder: Measures
		lineageTag: 70000013-0001-0001-0001-100000000001

	measure 'Total Rated Power KW' = SUM(diminverter[RatedPowerKW])
		formatString: #,0
		displayFolder: Measures
		lineageTag: 70000013-0001-0001-0001-100000000002

	measure 'Avg Inverter Efficiency' = AVERAGE(diminverter[Efficiency])
		formatString: #,0.0"%"
		displayFolder: Measures
		lineageTag: 70000013-0001-0001-0001-100000000003

