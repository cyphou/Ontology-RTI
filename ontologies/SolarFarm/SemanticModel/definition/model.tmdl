model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dimsolarplant","dimsolararray","sensortelemetry"]

ref table dimsolarplant
ref table dimsolararray
ref table sensortelemetry

ref expression DatabaseQuery

annotation PBI_QueryRelationships = []
